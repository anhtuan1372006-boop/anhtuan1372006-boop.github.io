HOST=127.0.0.1
PORT=4173
# Khi triển khai: NODE_ENV=production và mật khẩu riêng dài tối thiểu 12 ký tự.
# Không đưa mật khẩu thật vào Git hoặc giao diện website.
# ADMIN_PASSWORD=
# DATA_DIR=/var/lib/boxanh
# Cho phép giao diện GitHub Pages gọi API công khai, không mở API quản trị.
# PUBLIC_CLIENT_ORIGIN=https://anhtuan1372006-boop.github.io
# PUBLIC_PREVIEW=1
# Khi xuất bản GitHub Pages, đặt BOXANH_API_BASE bằng URL HTTPS của máy chủ API.
# BOXANH_API_BASE=https://your-api.example.com
# AI: chỉ đặt khóa trong .env riêng trên máy chủ; tuyệt đối không đặt trong public/ hoặc GitHub Pages.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# BOXANH_AI_REASONING=low
# BOXANH_AI_ENABLED=1
# BOXANH_AI_DAILY_LIMIT=100
